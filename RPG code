class Game:

    def __init__(self):

        self.player = None
        self.running = True

    # --------------------------------------------------------

    def start(self):

        clear()

        divider()
        print("⚔️  ETERNAL REALMS")
        print("      THE LOST CROWN")
        divider()

        print("\n1. New Game")
        print("2. Load Game")
        print("3. Exit")

        choice = ask_choice(
            "\nChoose: ",
            ["1", "2", "3"]
        )

        if choice == "1":
            self.create_character()

        elif choice == "2":
            if self.load_game():
                self.main_loop()

        else:
            print("Goodbye!")

    # --------------------------------------------------------

    def create_character(self):

        clear()

        print("CREATE YOUR HERO")
        divider()

        name = input("Enter your name: ").strip()

        while not name:
            name = input("Name cannot be empty: ").strip()

        print("\nChoose your class:\n")

        print("1. Warrior")
        print("   High HP and strong physical attacks.")

        print("\n2. Mage")
        print("   Huge mana pool and powerful magic.")

        print("\n3. Rogue")
        print("   Fast and deadly.")

        print("\n4. Paladin")
        print("   Extremely defensive holy warrior.")

        choice = ask_choice(
            "\nClass: ",
            ["1", "2", "3", "4"]
        )

        classes = {
            "1": "warrior",
            "2": "mage",
            "3": "rogue",
            "4": "paladin"
        }

        character_class = classes[choice]

        self.player = Player(
            name,
            character_class
        )

        clear()

        slow_print(
            f"\nWelcome, {self.player.name}."
        )

        pause()

        slow_print(
            "\nYour journey begins in the kingdom of Eldoria..."
        )

        pause(2)

        self.introduction()

        self.main_loop()

    # --------------------------------------------------------

    def introduction(self):

        clear()

        divider()

        slow_print(
            "For one thousand years, Eldoria was protected by "
            "the legendary Crown of Aether."
        )

        slow_print(
            "\nThe crown was said to possess enough power "
            "to control the ancient elements."
        )

        slow_print(
            "\nBut three nights ago..."
        )

        pause(1)

        slow_print(
            "\nThe crown disappeared."
        )

        slow_print(
            "\nThe king's guards searched the entire castle."
        )

        slow_print(
            "\nThey found only one clue:"
        )

        print("\nA black feather covered in strange blue dust.")

        pause(2)

        slow_print(
            "\nThe king believes the crown was stolen by "
            "the mysterious Dark Order."
        )

        slow_print(
            "\nAnd now..."
        )

        slow_print(
            "\nYou have been chosen to find it."
        )

        input("\nPress ENTER to continue...")

    # ========================================================
    #                         MAIN LOOP
    # ========================================================

    def main_loop(self):

        while self.running:

            clear()

            print(f"⚔️ {self.player.name}")
            print(
                f"Level {self.player.level} "
                f"| HP {self.player.hp}/{self.player.max_hp} "
                f"| MP {self.player.mp}/{self.player.max_mp}"
            )

            divider()

            print("1. Explore")
            print("2. Character")
            print("3. Inventory")
            print("4. Shop")
            print("5. Quests")
            print("6. Save Game")
            print("7. Exit")

            choice = ask_choice(
                "\nChoose: ",
                ["1", "2", "3", "4", "5", "6", "7"]
            )

            if choice == "1":
                self.explore()

            elif choice == "2":
                self.character_screen()

            elif choice == "3":
                self.inventory_screen()

            elif choice == "4":
                self.shop()

            elif choice == "5":
                self.quest_screen()

            elif choice == "6":
                self.save_game()

            elif choice == "7":
                print("\nThanks for playing!")
                self.running = False

    # ========================================================
    #                         EXPLORE
    # ========================================================

    def explore(self):

        clear()

        print("🌲 THE WILDERNESS")
        divider()

        print("You walk deeper into the wilderness...")

        pause(1)

        event = random.randint(1, 100)

        if event <= 50:

            enemy = random.choice(ENEMIES)

            enemy = enemy.copy()

            scale = max(0, self.player.level - enemy["level"])

            enemy["hp"] += scale * 15
            enemy["attack"] += scale * 3
            enemy["defense"] += scale * 2

            self.battle(enemy)

        elif event <= 70:

            gold = random.randint(20, 100)

            print(
                f"\n💰 You found {gold} gold hidden under a rock!"
            )

            self.player.gold += gold

        elif event <= 85:

            item = random.choice([
                "health_potion",
                "mana_potion"
            ])

            print(
                f"\n🎁 You found a {ITEMS[item]['name']}!"
            )

            self.add_item(item)

        elif event <= 95:

            print("\n🏚️ You discovered an abandoned cabin.")

            self.random_cabin()

        else:

            print("\n✨ A mysterious portal appears!")

            self.secret_area()

        input("\nPress ENTER to continue...")

