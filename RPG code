class Player:

    def __init__(self, name, character_class):

        self.name = name
        self.character_class = character_class

        self.level = 1
        self.xp = 0
        self.xp_required = 100

        self.max_hp = 100
        self.hp = 100

        self.max_mp = 50
        self.mp = 50

        self.base_attack = 10
        self.base_defense = 5

        self.gold = 150

        self.inventory = {
            "health_potion": 3,
            "mana_potion": 2
        }

        self.weapon = None
        self.armor = None

        self.quests = {
            "goblin_hunt": False,
            "dark_knight": False,
            "lost_crown": False
        }

        self.kills = 0

        self.apply_class_bonus()

    # --------------------------------------------------------

    def apply_class_bonus(self):

        if self.character_class == "warrior":
            self.max_hp += 40
            self.hp = self.max_hp
            self.base_attack += 5
            self.base_defense += 5

        elif self.character_class == "mage":
            self.max_mp += 70
            self.mp = self.max_mp
            self.base_attack += 10

        elif self.character_class == "rogue":
            self.base_attack += 8
            self.base_defense += 3

        elif self.character_class == "paladin":
            self.max_hp += 25
            self.hp = self.max_hp
            self.base_defense += 10

    # --------------------------------------------------------

    def attack_power(self):

        weapon_attack = 0

        if self.weapon:
            weapon_attack = ITEMS[self.weapon].get("attack", 0)

        return self.base_attack + weapon_attack

    # --------------------------------------------------------

    def defense_power(self):

        armor_defense = 0

        if self.armor:
            armor_defense = ITEMS[self.armor].get("defense", 0)

        return self.base_defense + armor_defense

    # --------------------------------------------------------

    def gain_xp(self, amount):

        print(f"\n⭐ You gained {amount} XP!")

        self.xp += amount

        while self.xp >= self.xp_required:

            self.xp -= self.xp_required
            self.level_up()

    # --------------------------------------------------------

    def level_up(self):

        self.level += 1

        self.xp_required = int(self.xp_required * 1.35)

        self.max_hp += 20
        self.max_mp += 10

        self.hp = self.max_hp
        self.mp = self.max_mp

        self.base_attack += 3
        self.base_defense += 2

        print()
        divider()
        print(f"🎉 LEVEL UP!")
        print(f"You are now level {self.level}!")
        print("+20 Maximum HP")
        print("+10 Maximum MP")
        print("+3 Attack")
        print("+2 Defense")
        divider()

    # --------------------------------------------------------

    def heal_full(self):

        self.hp = self.max_hp
        self.mp = self.max_mp


