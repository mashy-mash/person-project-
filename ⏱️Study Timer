import time

def timer(minutes):
    seconds = minutes * 60

    while seconds:
        mins, secs = divmod(seconds, 60)
        print(f"\r⏱️ {mins:02d}:{secs:02d}", end="")
        time.sleep(1)
        seconds -= 1

    print("\n🔔 Time's up!")

def main():
    print("📚 STUDY TIMER")

    try:
        minutes = int(input("Study time in minutes: "))

        if minutes <= 0:
            print("Enter a positive number.")
            return

        print("\nStarting study session...")
        timer(minutes)

    except ValueError:
        print("Please enter a number.")

